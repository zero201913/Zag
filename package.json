{
  "name": "zag-blog",
  "version": "1.0.0",
  "private": true,
  "description": "Zag · 玻璃拟态多功能博客（Next.js + Cloudflare D1 + R2）",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply zag-blog-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply zag-blog-db --remote",
    "db:studio": "wrangler d1 execute zag-blog-db --local --command \"SELECT name FROM sqlite_master WHERE type='table'\""
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "lenis": "^1.3.27",
    "marked": "18.1.3",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261107.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "wrangler": "4.158.0"
  }
}
